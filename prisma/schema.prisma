generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum VisibilityScope {
  PUBLIC_SAFE
  INTERNAL
  RESTRICTED
  SUPPLIER_CONFIDENTIAL
}

enum IntegrationMode {
  MOCK
  DRY_RUN
  LIVE
}

enum AutomationStatus {
  DRAFT
  QUEUED
  SUBMITTED
  RUNNING
  WAITING_FOR_EXTERNAL_SERVICE
  WAITING_FOR_CALLBACK
  COMPLETED
  COMPLETED_WITH_WARNINGS
  FAILED
  RETRY_SCHEDULED
  AWAITING_HUMAN_REVIEW
  REVISION_REQUESTED
  APPROVED_INTERNAL
  APPROVED_FOR_PUBLICATION
  REJECTED
  CANCEL_REQUESTED
  CANCELLED
  ARCHIVED
}

enum ContentStatus {
  DRAFT
  SUBMITTED
  GENERATING
  WAITING_FOR_EXTERNAL_SERVICE
  GENERATION_COMPLETED
  AWAITING_REVIEW
  REVISION_REQUESTED
  APPROVED_INTERNAL
  APPROVED_PUBLICATION
  REJECTED
  ARCHIVED
  FAILED
}

enum PublishPlatform {
  FACEBOOK
  INSTAGRAM
}

enum PublishStatus {
  DRAFT
  DRY_RUN
  QUEUED
  PUBLISHED
  PARTIAL_SUCCESS
  FAILED
  CANCELLED
}

enum FileSecurityStatus {
  PENDING
  CLEAN
  REJECTED
  SCAN_UNAVAILABLE
}

enum KnowledgeDocumentLifecycle {
  ACTIVE
  ARCHIVED
}

enum KnowledgeDocumentReviewStatus {
  UPLOADED
  READY_FOR_REVIEW
  UNDER_REVIEW
  APPROVED_SOURCE
  REJECTED
  SUPERSEDED
}

enum KnowledgeClaimStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
  EXPIRED
}

enum KnowledgeClaimUsageScope {
  PUBLIC_SAFE
  INTERNAL_ONLY
  RESTRICTED
}

enum KnowledgeTranslationReviewStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum KnowledgeExtractionStatus {
  RUNNING
  SUCCEEDED
  FAILED
  UNSUPPORTED
}

model User {
  id                    String       @id @default(cuid())
  username              String       @unique
  displayName           String
  email                 String?
  passwordHash          String       @db.VarChar(255)
  status                UserStatus   @default(ACTIVE)
  mustChangePassword    Boolean      @default(false)
  failedLoginCount      Int          @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  roles                 UserRole[]
  sessions              Session[]
  auditEvents           AuditEvent[] @relation("AuditActor")
  knowledgeDocumentsCreated KnowledgeDocument[] @relation("KnowledgeDocumentCreator")
  knowledgeVersionsUploaded KnowledgeDocumentVersion[] @relation("KnowledgeVersionUploader")
  knowledgeExtractionsRequested KnowledgeDocumentExtraction[] @relation("KnowledgeExtractionRequester")
  knowledgeVersionsReviewed KnowledgeDocumentVersion[] @relation("KnowledgeVersionReviewer")
  knowledgeVersionsApproved KnowledgeDocumentVersion[] @relation("KnowledgeVersionApprover")
  knowledgeReviewEvents KnowledgeDocumentVersionReview[] @relation("KnowledgeReviewActor")
  knowledgeClaimsCreated KnowledgeClaim[] @relation("KnowledgeClaimCreator")
  knowledgeClaimsEdited KnowledgeClaim[] @relation("KnowledgeClaimEditor")
  knowledgeClaimsReviewed KnowledgeClaim[] @relation("KnowledgeClaimReviewer")
  knowledgeClaimsApproved KnowledgeClaim[] @relation("KnowledgeClaimApprover")
  knowledgeTranslationsReviewed KnowledgeClaimTranslation[] @relation("KnowledgeTranslationReviewer")
  knowledgeTranslationsApproved KnowledgeClaimTranslation[] @relation("KnowledgeTranslationApprover")
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?  @db.Text
  users       UserRole[]
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String @db.Text
}

model UserRole {
  id        String @id @default(cuid())
  userId    String
  roleId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model Session {
  id        String        @id @default(cuid())
  userId    String
  tokenHash String        @unique
  status    SessionStatus @default(ACTIVE)
  ipAddress String?
  userAgent String?       @db.Text
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  summary     String   @db.Text
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model IntegrationSetting {
  id          String          @id @default(cuid())
  service     String
  mode        IntegrationMode @default(MOCK)
  enabled     Boolean         @default(false)
  reference   String?
  status      String          @default("not_configured")
  lastCheckedAt DateTime?
  notes       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model AutomationJob {
  id                 String           @id @default(cuid())
  jobType            String
  title              String
  relatedEntityType  String?
  relatedEntityId    String?
  contentRequestId   String?
  requestedByUserId  String?
  priority           String           @default("normal")
  workflowName       String
  workflowVersion    String           @default("mock-v1")
  inputPayload       Json
  currentStatus      AutomationStatus @default(QUEUED)
  currentStep        String?
  n8nExecutionId     String?
  externalService    String?
  externalCreationId String?
  outputPayload      Json?
  errorCode          String?
  errorMessage       String?          @db.Text
  retryCount         Int              @default(0)
  maxRetries         Int              @default(3)
  creditCost         Int?
  moneyCost          Decimal?         @db.Decimal(10, 2)
  humanReviewStatus  String           @default("not_required")
  approvalId         String?
  idempotencyKey     String           @unique
  correlationId      String           @unique
  archiveStatus      String           @default("active")
  visibilityScope    VisibilityScope  @default(INTERNAL)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  events             AutomationJobEvent[]
}

model AutomationJobEvent {
  id             String           @id @default(cuid())
  jobId          String
  eventType      String
  previousStatus AutomationStatus?
  newStatus      AutomationStatus?
  actorType      String           @default("platform")
  actorId        String?
  message        String           @db.Text
  payloadSummary Json?
  retryNumber    Int              @default(0)
  externalReference String?
  createdAt      DateTime         @default(now())
  job            AutomationJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model Organization {
  id          String   @id @default(cuid())
  legalName   String
  displayName String?
  country     String?
  market      String?
  status      String   @default("active")
  notes       String?  @db.Text
  synthetic   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       OrganizationRole[]
  contacts    Contact[]
  leads       Lead[]
  inquiries   Inquiry[]
  customerProfile CustomerProfile?
  supplierProfile SupplierProfile?
  deals       Deal[]
}

model OrganizationRole {
  id             String       @id @default(cuid())
  organizationId String
  role           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role])
}

model Contact {
  id             String        @id @default(cuid())
  organizationId String?
  fullName       String
  email          String?
  phone          String?
  whatsapp       String?
  country        String?
  status         String        @default("active")
  synthetic      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  leads          Lead[]
}

model Lead {
  id                String       @id @default(cuid())
  sourceLeadId      String?      @unique
  organizationId    String?
  contactId         String?
  leadType          String
  source            String       @default("manual")
  status            String       @default("new")
  quality           String       @default("unreviewed")
  firstTouchDueAt   DateTime?
  firstTouchDoneAt  DateTime?
  ownerUserId       String?
  rawPayload        Json?
  rawPayloadRestricted Boolean   @default(true)
  synthetic         Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contact           Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  inquiries         Inquiry[]
}

model Inquiry {
  id             String        @id @default(cuid())
  leadId         String?
  organizationId String?
  inquiryType    String
  product        String?
  quantity       String?
  quantityUnit   String?
  packaging      String?
  destination    String?
  incoterms      String?
  paymentTerms   String?
  certifications String?
  message        String?       @db.Text
  status         String        @default("received")
  synthetic      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
}

model CustomerProfile {
  id             String       @id @default(cuid())
  organizationId String       @unique
  status         String       @default("prospect")
  market         String?
  notes          String?      @db.Text
  synthetic      Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SupplierProfile {
  id             String          @id @default(cuid())
  organizationId String          @unique
  verificationStatus String      @default("unreviewed")
  productOffered String?
  monthlyCapacityMt String?
  originCountry  String?
  certifications String?         @db.Text
  internalNotes  String?         @db.Text
  visibilityScope VisibilityScope @default(SUPPLIER_CONFIDENTIAL)
  synthetic      Boolean         @default(false)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Deal {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  status         String       @default("open")
  stage          String       @default("lead_review")
  ownerUserId    String?
  nextAction     String?
  nextActionDueAt DateTime?
  synthetic      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lineItems      DealLineItem[]
  stageHistory   DealStageHistory[]
}

model DealStage {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  sortOrder Int
  active    Boolean  @default(true)
}

model DealStageHistory {
  id        String   @id @default(cuid())
  dealId    String
  stage     String
  reason    String?  @db.Text
  enteredAt DateTime @default(now())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model DealLineItem {
  id          String @id @default(cuid())
  dealId      String
  productId   String?
  description String? @db.Text
  quantity    String?
  unit        String?
  packaging   String?
  destination String?
  status      String @default("requested")
  deal        Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model Task {
  id          String   @id @default(cuid())
  title       String
  relatedType String?
  relatedId   String?
  ownerUserId String?
  status      String   @default("open")
  dueAt       DateTime?
  completedAt DateTime?
  synthetic   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Document {
  id          String          @id @default(cuid())
  documentType String
  title       String
  fileId      String?
  relatedType String?
  relatedId   String?
  status      String          @default("draft")
  visibilityScope VisibilityScope @default(RESTRICTED)
  synthetic   Boolean         @default(false)
  createdAt   DateTime        @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  category    String
  status      String   @default("active")
  tdsStatus   String   @default("not_found")
  publicMarketingAllowed Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  brandId     String?
  brand       Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  knowledgeClaimApplicability KnowledgeClaimProduct[]
  @@index([brandId])
}

model PackagingFormat {
  id        String @id @default(cuid())
  label     String @unique
  status    String @default("approved")
  visualAssetStatus String @default("missing")
  knowledgeClaimApplicability KnowledgeClaimPackagingFormat[]
}

model Brand {
  id String @id @default(cuid())
  key String @unique
  name String @unique
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products Product[]
  knowledgeClaimApplicability KnowledgeClaimBrand[]
}

model KnowledgeIndex {
  id          String          @id @default(cuid())
  claimId     String          @unique
  approvedWording String      @db.Text
  sourceFile  String
  sourceSection String
  contentHash String?
  verificationStatus String   @default("verified")
  visibilityScope VisibilityScope @default(PUBLIC_SAFE)
  restrictions String?        @db.Text
  lastSyncedAt DateTime?
  conflictState String        @default("none")
  synthetic    Boolean        @default(false)
}

model KnowledgeDocument {
  id              String                     @id @default(cuid())
  title           String
  category        String
  sourceType      String
  locale          String                     @default("en")
  market          String?
  notes           String?                    @db.Text
  lifecycleStatus KnowledgeDocumentLifecycle @default(ACTIVE)
  createdByUserId String
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  createdBy       User                       @relation("KnowledgeDocumentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions        KnowledgeDocumentVersion[]

  @@index([lifecycleStatus, updatedAt])
  @@index([category])
  @@index([locale])
  @@index([market])
}

model KnowledgeDocumentVersion {
  id                  String                         @id @default(cuid())
  documentId          String
  fileObjectId        String                         @unique
  versionNumber       Int
  versionLabel        String?
  uploadedByUserId    String
  createdAt           DateTime                       @default(now())
  supersedesVersionId String?                        @unique
  reviewStatus        KnowledgeDocumentReviewStatus @default(UPLOADED)
  reviewedByUserId String?
  reviewedAt DateTime?
  approvedByUserId String?
  approvedAt DateTime?
  rejectionReason String? @db.Text
  reviewNotes String? @db.Text
  supersededAt DateTime?
  document            KnowledgeDocument              @relation(fields: [documentId], references: [id], onDelete: Restrict)
  fileObject          FileObject                     @relation(fields: [fileObjectId], references: [id], onDelete: Restrict)
  uploadedBy          User                           @relation("KnowledgeVersionUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("KnowledgeVersionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  approvedBy User? @relation("KnowledgeVersionApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  supersedes          KnowledgeDocumentVersion?      @relation("KnowledgeVersionSupersession", fields: [supersedesVersionId], references: [id], onDelete: Restrict)
  supersededBy        KnowledgeDocumentVersion?      @relation("KnowledgeVersionSupersession")
  reviewEvents KnowledgeDocumentVersionReview[]
  claimSources KnowledgeClaimSource[]
  extractions KnowledgeDocumentExtraction[]

  @@unique([documentId, versionNumber], map: "KnowledgeVersion_document_version_key")
  @@index([documentId, createdAt])
  @@index([reviewStatus])
  @@index([reviewStatus, createdAt])
  @@index([approvedAt])
}

model KnowledgeDocumentExtraction {
  id String @id @default(cuid())
  documentVersionId String
  requestedByUserId String
  status KnowledgeExtractionStatus @default(RUNNING)
  extractorName String
  extractorVersion String
  sourceSha256 String @db.VarChar(64)
  contentHash String? @db.VarChar(64)
  pageCount Int?
  fragmentCount Int @default(0)
  characterCount Int @default(0)
  errorCode String? @db.VarChar(120)
  errorMessage String? @db.Text
  startedAt DateTime @default(now())
  completedAt DateTime?
  createdAt DateTime @default(now())
  documentVersion KnowledgeDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  requestedBy User @relation("KnowledgeExtractionRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  fragments KnowledgeExtractionFragment[]
  @@index([documentVersionId, createdAt])
  @@index([status, createdAt])
  @@index([requestedByUserId, createdAt])
}

model KnowledgeExtractionFragment {
  id String @id @default(cuid())
  extractionId String
  ordinal Int
  pageNumber Int?
  sectionHeading String? @db.VarChar(500)
  content String @db.LongText
  contentHash String @db.VarChar(64)
  characterCount Int
  createdAt DateTime @default(now())
  extraction KnowledgeDocumentExtraction @relation(fields: [extractionId], references: [id], onDelete: Restrict)
  @@unique([extractionId, ordinal])
  @@index([extractionId, pageNumber])
}

model KnowledgeDocumentVersionReview {
  id String @id @default(cuid())
  versionId String
  actorUserId String
  action String
  previousStatus KnowledgeDocumentReviewStatus
  newStatus KnowledgeDocumentReviewStatus
  notes String? @db.Text
  rejectionReason String? @db.Text
  createdAt DateTime @default(now())
  version KnowledgeDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  actor User @relation("KnowledgeReviewActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  @@index([versionId, createdAt])
  @@index([newStatus, createdAt])
}

model KnowledgeClaim {
  id String @id @default(cuid())
  stableKey String
  revision Int @default(1)
  claimType String
  status KnowledgeClaimStatus @default(DRAFT)
  usageScope KnowledgeClaimUsageScope
  requiredLocales Json
  effectiveAt DateTime?
  expiresAt DateTime?
  restrictions String? @db.Text
  internalNotes String? @db.Text
  rejectionReason String? @db.Text
  reviewNotes String? @db.Text
  createdByUserId String
  lastEditedByUserId String
  reviewedByUserId String?
  reviewedAt DateTime?
  approvedByUserId String?
  approvedAt DateTime?
  supersedesClaimId String? @unique
  replacesApprovedClaimId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User @relation("KnowledgeClaimCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lastEditedBy User @relation("KnowledgeClaimEditor", fields: [lastEditedByUserId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("KnowledgeClaimReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  approvedBy User? @relation("KnowledgeClaimApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  supersedes KnowledgeClaim? @relation("KnowledgeClaimSupersession", fields: [supersedesClaimId], references: [id], onDelete: Restrict)
  supersededBy KnowledgeClaim? @relation("KnowledgeClaimSupersession")
  replacesApproved KnowledgeClaim? @relation("KnowledgeClaimApprovedReplacement", fields: [replacesApprovedClaimId], references: [id], onDelete: Restrict)
  replacementAttempts KnowledgeClaim[] @relation("KnowledgeClaimApprovedReplacement")
  translations KnowledgeClaimTranslation[]
  sources KnowledgeClaimSource[]
  brands KnowledgeClaimBrand[]
  products KnowledgeClaimProduct[]
  packagingFormats KnowledgeClaimPackagingFormat[]
  markets KnowledgeClaimMarket[]
  audiences KnowledgeClaimAudience[]
  objectives KnowledgeClaimObjective[]
  @@unique([stableKey, revision], map: "KnowledgeClaim_stableKey_revision_key")
  @@index([stableKey])
  @@index([status, updatedAt])
  @@index([usageScope, status])
  @@index([effectiveAt])
  @@index([expiresAt])
  @@index([replacesApprovedClaimId, status])
}

model KnowledgeClaimTranslation {
  id String @id @default(cuid())
  claimId String
  locale String
  wording String @db.Text
  reviewStatus KnowledgeTranslationReviewStatus @default(DRAFT)
  reviewedByUserId String?
  reviewedAt DateTime?
  approvedByUserId String?
  approvedAt DateTime?
  reviewNotes String? @db.Text
  rejectionReason String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  claim KnowledgeClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("KnowledgeTranslationReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  approvedBy User? @relation("KnowledgeTranslationApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  @@unique([claimId, locale])
  @@index([locale, reviewStatus])
  @@index([reviewStatus, updatedAt])
}

model KnowledgeClaimSource {
  id String @id @default(cuid())
  claimId String
  documentVersionId String
  pageNumber Int?
  sectionHeading String? @db.VarChar(500)
  tableFigureReference String? @db.VarChar(500)
  sourceExcerpt String? @db.Text
  sourceNotes String? @db.Text
  createdAt DateTime @default(now())
  claim KnowledgeClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  documentVersion KnowledgeDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  @@index([claimId])
  @@index([documentVersionId, claimId])
}

model KnowledgeClaimBrand {
  claimId String
  brandId String
  claim KnowledgeClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  @@id([claimId, brandId])
  @@index([brandId, claimId])
}
model KnowledgeClaimProduct {
  claimId String
  productId String
  claim KnowledgeClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@id([claimId, productId])
  @@index([productId, claimId])
}
model KnowledgeClaimPackagingFormat {
  claimId String
  packagingFormatId String
  claim KnowledgeClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  packagingFormat PackagingFormat @relation(fields: [packagingFormatId], references: [id], onDelete: Restrict)
  @@id([claimId, packagingFormatId])
  @@index([packagingFormatId, claimId])
}
model KnowledgeClaimMarket {
  id String @id @default(cuid())
  claimId String
  value String
  claim KnowledgeClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  @@unique([claimId, value])
  @@index([value, claimId])
}
model KnowledgeClaimAudience {
  id String @id @default(cuid())
  claimId String
  value String
  claim KnowledgeClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  @@unique([claimId, value])
  @@index([value, claimId])
}
model KnowledgeClaimObjective {
  id String @id @default(cuid())
  claimId String
  value String
  claim KnowledgeClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  @@unique([claimId, value])
  @@index([value, claimId])
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  brand       String
  businessLine String?
  status      String   @default("draft")
  synthetic   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ContentRequest {
  id          String        @id @default(cuid())
  topic       String        @db.Text
  brand       String
  businessLine String
  product     String?
  market      String?
  audience    String?
  objective   String?       @db.Text
  channel     String?
  format      String
  cta         String?
  creativeTemplateId String?
  internalNotes String?     @db.Text
  status      ContentStatus @default(DRAFT)
  requestedPublishingChannels Json?
  createdByUserId String?
  synthetic   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       ContentItem[]
  assets      CreativeAsset[]
}

model ContentItem {
  id          String        @id @default(cuid())
  contentRequestId String
  version     Int           @default(1)
  headline    String?
  caption     String?       @db.Text
  cta         String?
  hashtags    String?       @db.Text
  status      ContentStatus @default(GENERATION_COMPLETED)
  metadata    Json?
  createdAt   DateTime      @default(now())
  request     ContentRequest @relation(fields: [contentRequestId], references: [id], onDelete: Cascade)
  publishingRecords PublishingRecord[]
}

model CreativeAsset {
  id          String          @id @default(cuid())
  contentRequestId String?
  fileId      String?
  assetType   String
  status      String          @default("draft")
  approvalStatus String       @default("not_approved")
  sourceTool  String          @default("mock")
  metadata    Json?
  visibilityScope VisibilityScope @default(INTERNAL)
  createdAt   DateTime        @default(now())
  request     ContentRequest? @relation(fields: [contentRequestId], references: [id], onDelete: SetNull)
}

model FileObject {
  id          String          @id @default(cuid())
  storageKey  String          @unique
  originalName String
  mimeType    String
  sizeBytes   Int
  sha256Hash  String
  fileExtension String?
  declaredMimeType String?
  securityStatus FileSecurityStatus @default(PENDING)
  width       Int?
  height      Int?
  durationSeconds Int?
  assetType   String
  visibilityScope VisibilityScope @default(INTERNAL)
  approvalStatus String       @default("not_approved")
  version     Int             @default(1)
  createdByUserId String?
  synthetic   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  knowledgeVersion KnowledgeDocumentVersion?

  @@index([sha256Hash])
  @@index([securityStatus])
}

model Approval {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  approvalType String
  status      String   @default("requested")
  requestedByUserId String?
  decidedByUserId String?
  decisionNotes String? @db.Text
  decidedAt   DateTime?
  createdAt   DateTime @default(now())
}

model PublishingRecord {
  id          String        @id @default(cuid())
  contentItemId String
  platform    PublishPlatform
  status      PublishStatus @default(DRAFT)
  mode        IntegrationMode @default(MOCK)
  idempotencyKey String     @unique
  automationJobId String?
  requestedByUserId String?
  approvedByUserId String?
  platformPostId String?
  platformUrl String?
  publishedAt DateTime?
  warnings    Json?
  errors      Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  contentItem ContentItem   @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
}

