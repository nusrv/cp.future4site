# Copy to .env locally. Never commit real values.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
PORT=3000
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/cp_future_admin
SESSION_SECRET=change-me-minimum-32-characters
COOKIE_SECURE=false
INITIAL_ADMIN_USERNAME=owner
INITIAL_ADMIN_PASSWORD=change-me-on-first-login
INTEGRATION_MODE=mock
N8N_LIVE_ENABLED=false
N8N_BASE_URL=
N8N_WEBHOOK_BASE_PATH=webhook
N8N_CONTENT_WEBHOOK_PATH=future-foresight/content-generation
N8N_CREATIVE_IMAGE_WEBHOOK_PATH=future-foresight/creative-image-generation
N8N_CREATIVE_VIDEO_WEBHOOK_PATH=future-foresight/creative-video-generation
N8N_PUBLISH_WEBHOOK_PATH=future-foresight/publish-dry-run
N8N_WEBHOOK_SECRET=
N8N_API_KEY=
PLATFORM_CALLBACK_SECRET=change-me-minimum-32-characters
META_PUBLISHING_ENABLED=false
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=./storage
PUBLIC_ASSET_BASE_URL=
MAX_UPLOAD_MB=25
KNOWLEDGE_EXTRACTION_ENABLED=false
KNOWLEDGE_PDFTOTEXT_PATH=pdftotext
KNOWLEDGE_EXTRACTION_TIMEOUT_MS=30000
KNOWLEDGE_EXTRACTION_MAX_CHARS=2000000
KNOWLEDGE_OCR_ENABLED=false
KNOWLEDGE_TESSERACT_PATH=tesseract
KNOWLEDGE_PDFTOPPM_PATH=pdftoppm
KNOWLEDGE_OCR_TIMEOUT_MS=120000
KNOWLEDGE_OCR_MAX_PAGES=30
KNOWLEDGE_OCR_MAX_CHARS=2000000
KNOWLEDGE_OCR_MAX_RASTER_BYTES=262144000
KNOWLEDGE_OCR_LOW_CONFIDENCE=70
LOG_LEVEL=info

# n8n execution-container settings (not used by the CP process)
BRAND_ASSETS_BASE_DIR=/data/brand-assets
NODE_FUNCTION_ALLOW_BUILTIN=fs,path,crypto,http,https
NODE_FUNCTION_ALLOW_EXTERNAL=sharp
# Facebook page credentials remain in the n8n container/credential system only.
